generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPERADMIN
  OPERATOR_AGENCY
  OPERATOR_FREELANCE
}

enum OperatorType {
  AGENCY
  FREELANCE
}

enum VerificationStatus {
  DRAFT
  PENDING
  INFO_NEEDED
  APPROVED
  SUSPENDED
  REJECTED
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  name      String
  role      Role
  createdAt DateTime @default(now())

  operatorTermsAccepted   Boolean  @default(false)
  operatorTermsAcceptedAt DateTime?

  operator  Operator?
}

model Category {
  id        String       @id @default(cuid())
  name      String
  slug      String       @unique
  experiences Experience[]
  translations      CategoryTranslation[]
  countryCategories CountryCategory[]
    // Prevent deleting if used by Experience (enforce in backend)
}

model City {
  id          String       @id @default(cuid())
  name        String
  country     String // legacy free-text; ver countryId. Se elimina en la fase de limpieza post-backfill.
  countryId   String?
  countryRef  Country?     @relation(fields: [countryId], references: [id])
  regionId    String?
  region      Region?      @relation(fields: [regionId], references: [id])
  operators   Operator[]
  experiences Experience[]
    // Prevent deleting if used by Experience (enforce in backend)
}

model Operator {
  id          String       @id @default(cuid())
  name        String
  email       String       @unique
  phone       String?
  type        OperatorType @default(AGENCY)
  verificationStatus VerificationStatus @default(DRAFT)
  licenseNumber     String?
  licenseDocument   String?
  cnpj              String? // legacy; documento oficial vive ahora en OperatorDocument (por país)
  cpf               String? // legacy; ídem
  cadastur          String? // legacy; ídem
  contractUrl       String?
  categoria           String?
  legalRepresentative String?
  paymentAccount      String?
  reviewNotes         String?
  liabilityAccepted   Boolean  @default(false)
  liabilityAcceptedAt DateTime?
  contractAccepted   Boolean  @default(false)
  contractAcceptedAt DateTime?
  cityId      String
  city        City         @relation(fields: [cityId], references: [id])
  countryId   String?
  country     Country?     @relation(fields: [countryId], references: [id])
  documents   OperatorDocument[]
  userId      Int?         @unique
  user        User?        @relation(fields: [userId], references: [id])
  experiences Experience[]
    // Prevent deleting if used by Experience (enforce in backend)
  createdAt DateTime @default(now())
  updatedAt DateTime? @updatedAt
}

model Experience {
  id String @id @default(cuid())

  title String
  description String
  price Float
  durationMinutes Int
  capacity Int @default(0)
  images String[]

  coveragePolicy String?
  coverageDescription String?
  riskLevel   RiskLevel @default(LOW)

    operatorId String
    cityId String
    categoryId String
    countryId String?

  status ExperienceStatus @default(DRAFT)

  operator Operator @relation(fields: [operatorId], references: [id])
  city City @relation(fields: [cityId], references: [id])
  category Category @relation(fields: [categoryId], references: [id])
  country Country? @relation(fields: [countryId], references: [id])
  slots Slot[]
  availabilitySlots AvailabilitySlot[]
  bookings Booking[]
  createdAt DateTime @default(now())
  updatedAt DateTime? @updatedAt
}

model Slot {
  id String @id @default(cuid())
  experienceId String
  date DateTime
  time String
  capacity Int
  experience Experience @relation(fields: [experienceId], references: [id])
  createdAt DateTime @default(now())
}
enum ExperienceStatus {
  DRAFT
  PUBLISHED
}

model AvailabilitySlot {
  id           String     @id @default(cuid())
  experienceId String
  experience   Experience @relation(fields: [experienceId], references: [id])
  date         DateTime
  startTime    DateTime
  capacity     Int        @default(1)
  @@unique([experienceId, date, startTime])
  // capacity: required, integer, > 0, max 50 (enforced in backend)
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

model Booking {
  id             Int           @id @default(autoincrement())
  bookingCode    String?       @unique // código legible expuesto a clientes (QR, "mis reservas")
  experienceId   String
  date           DateTime
  guests         Int
  customerName   String
  customerEmail  String
  customerPhone  String?
  status         BookingStatus @default(PENDING)
  amount         Float
  depositAmount  Float
  remainingAmount Float
  paymentStatus  PaymentStatus @default(PENDING)
  paymentType    PaymentType   @default(DEPOSIT)
  qrCode         String?
  cancelReason   String?
  countryId      String?
  createdAt      DateTime      @default(now())

  experience Experience @relation(fields: [experienceId], references: [id])
  country    Country?   @relation(fields: [countryId], references: [id])
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
}

enum PaymentType {
  DEPOSIT
}

// ─────────────────────────────────────────────────────────────────────────
// Multi-país (Fase 0/1 — ver plan de arquitectura NativaGo LatAm)
// ─────────────────────────────────────────────────────────────────────────

model Country {
  id                String   @id @default(cuid())
  code              String   @unique // ISO-3166 alpha-2: "CO", "BR"
  name              String
  domainSlug        String   @unique // "co", "br" — subdominio del marketplace
  defaultCurrencyId String
  defaultCurrency   Currency @relation(fields: [defaultCurrencyId], references: [id])
  defaultLanguageId String
  defaultLanguage   Language @relation(fields: [defaultLanguageId], references: [id])
  timezoneId        String
  timezone          Timezone @relation(fields: [timezoneId], references: [id])
  taxRatePercent    Float    @default(0)
  commissionPercent Float    @default(0)
  isActive          Boolean  @default(true)
  seoTitle          String?
  seoDescription    String?

  cities                  City[]
  operators               Operator[]
  experiences             Experience[]
  bookings                Booking[]
  regions                 Region[]
  documentTypes           DocumentType[]
  countryCategories       CountryCategory[]
  countryPaymentProviders CountryPaymentProvider[]

  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt
}

model Currency {
  id            String    @id @default(cuid())
  code          String    @unique // ISO-4217: "COP", "BRL", "USD"...
  symbol        String
  decimalDigits Int       @default(0)
  countries     Country[]
}

model Language {
  id                   String                 @id @default(cuid())
  code                 String                 @unique // ISO-639-1: "es", "pt", "en"
  name                 String
  countries            Country[]
  categoryTranslations CategoryTranslation[]
}

model Timezone {
  id        String    @id @default(cuid())
  ianaName  String    @unique // "America/Bogota", "America/Sao_Paulo"
  label     String
  countries Country[]
}

model Region {
  id        String  @id @default(cuid())
  countryId String
  country   Country @relation(fields: [countryId], references: [id])
  name      String
  code      String?
  cities    City[]

  @@unique([countryId, name])
}

model CategoryTranslation {
  id         String   @id @default(cuid())
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])
  languageId String
  language   Language @relation(fields: [languageId], references: [id])
  name       String

  @@unique([categoryId, languageId])
}

// Qué categorías están habilitadas (y en qué orden) por país. La categoría
// en sí es global (taxonomía compartida) — esto evita duplicarla por país.
model CountryCategory {
  id         String   @id @default(cuid())
  countryId  String
  country    Country  @relation(fields: [countryId], references: [id])
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])
  isEnabled  Boolean  @default(true)
  sortOrder  Int      @default(0)

  @@unique([countryId, categoryId])
}

// Qué documento oficial exige cada país para verificar un operador
// (RNT en CO, CNPJ/CPF+CADASTUR en BR, RFC en MX...). Configurable desde
// datos, no desde código.
model DocumentType {
  id                String             @id @default(cuid())
  countryId         String
  country           Country            @relation(fields: [countryId], references: [id])
  code              String // "RNT", "CNPJ", "CPF", "CADASTUR", "RFC"...
  label             String
  validationRegex   String?
  isRequired        Boolean            @default(true)
  operatorDocuments OperatorDocument[]

  @@unique([countryId, code])
}

model OperatorDocument {
  id             String       @id @default(cuid())
  operatorId     String
  operator       Operator     @relation(fields: [operatorId], references: [id])
  documentTypeId String
  documentType   DocumentType @relation(fields: [documentTypeId], references: [id])
  value          String
  verified       Boolean      @default(false)
  createdAt      DateTime     @default(now())

  @@unique([operatorId, documentTypeId])
}

model PaymentProvider {
  id                      String                    @id @default(cuid())
  code                    String                    @unique // "stripe", "wompi", "mercadopago", "pix"
  displayName             String
  countryPaymentProviders CountryPaymentProvider[]
}

// Qué proveedor(es) de pago usa cada país, y con qué prioridad. `configRef`
// apunta al nombre de la variable de entorno con las credenciales — nunca
// el secreto en sí.
model CountryPaymentProvider {
  id                String          @id @default(cuid())
  countryId         String
  country           Country         @relation(fields: [countryId], references: [id])
  paymentProviderId String
  paymentProvider   PaymentProvider @relation(fields: [paymentProviderId], references: [id])
  priority          Int             @default(0)
  isActive          Boolean         @default(false)
  configRef         String?

  @@unique([countryId, paymentProviderId])
}
