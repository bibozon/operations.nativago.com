generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Usuarios del sistema (operadores, agencias, admins)
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  role      UserRole
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  operator  Operator?
  agency    Agency?  @relation(fields: [agencyId], references: [id])
  agencyId  String?

  bookings  Booking[]
}

model Operator {
  id        String   @id @default(cuid())
  name      String
  status    OperatorStatus @default(PENDING)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id])
  userId    String   @unique

  experiences Experience[]
}

model Agency {
  id          String   @id @default(cuid())
  name        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       User[]
  experiences Experience[]
}

model Experience {
  id                   String   @id @default(cuid())
  title                String
  description          String
  // city & category se resuelven mediante tablas City y Category
  durationMinutes      Int
  price                Decimal
  coveragePolicy       String
  coverageDescription  String
  photos               Json

  operator   Operator  @relation(fields: [operatorId], references: [id])
  operatorId String

  agency     Agency?   @relation(fields: [agencyId], references: [id])
  agencyId   String?

  slots      ExperienceSlot[]
  bookings   Booking[]

  // Relaciones opcionales con catálogos
  city       City?      @relation(fields: [cityId], references: [id])
  cityId     String?
  category   Category?  @relation(fields: [categoryId], references: [id])
  categoryId String?

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model ExperienceSlot {
  id           String     @id @default(cuid())
  date         DateTime
  startTime    DateTime
  capacity     Int

  experience   Experience @relation(fields: [experienceId], references: [id])
  experienceId String

  bookings     Booking[]
}

model Booking {
  id              String      @id @default(cuid())
  status          BookingStatus
  startAt         DateTime
  arrivalAt       DateTime?
  deadline        DateTime
  clientName      String
  clientEmail     String
  amountToCollect Decimal     /// 85% mostrado en UI

  user        User          @relation(fields: [userId], references: [id])
  userId      String

  experience  Experience    @relation(fields: [experienceId], references: [id])
  experienceId String

  slot        ExperienceSlot @relation(fields: [slotId], references: [id])
  slotId      String

  communications Communication[]
  events         BookingEvent[]
  reviews        Review[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// Ciudades canónicas para experiencias (compartidas con marketplace)
model City {
  id        String       @id @default(cuid())
  name      String       @unique
  country   String

  experiences Experience[]
}

/// Categorías de experiencias (compartidas con marketplace)
model Category {
  id          String       @id @default(cuid())
  name        String       @unique
  description String?

  experiences Experience[]
}

/// Comunicaciones enviadas al cliente (email, whatsapp, sms)
model Communication {
  id        String   @id @default(cuid())
  booking   Booking  @relation(fields: [bookingId], references: [id])
  bookingId String

  channel   String
  template  String?
  content   String?
  sentAt    DateTime
  status    String
}

/// Eventos de la reserva (creación, cambios de estado, check-in, etc.)
model BookingEvent {
  id        String   @id @default(cuid())
  booking   Booking  @relation(fields: [bookingId], references: [id])
  bookingId String

  type      String
  payload   Json?
  createdAt DateTime @default(now())
}

/// Reseñas que los clientes dejan sobre la experiencia
model Review {
  id          String   @id @default(cuid())
  booking     Booking  @relation(fields: [bookingId], references: [id])
  bookingId   String

  rating      Int
  comment     String?
  createdAt   DateTime @default(now())
}

enum UserRole {
  OPERATOR
  AGENCY
  ADMIN
}

enum OperatorStatus {
  PENDING
  APPROVED
  SUSPENDED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}
